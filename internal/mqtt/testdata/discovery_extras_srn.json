[
  {
    "topic": "homeassistant/sensor/openqiara_32_battery/config",
    "payload": {
      "device": {
        "identifiers": [
          "openqiara_32"
        ],
        "manufacturer": "Qiara/Cofidur",
        "model": "HOMELABSRN",
        "name": "OpenQiara SRN 32"
      },
      "device_class": "battery",
      "json_attributes_topic": "openqiara/sensor/32/state",
      "name": "OpenQiara SRN 32 Batterie",
      "state_topic": "openqiara/sensor/32/state",
      "unique_id": "openqiara_srn_32_battery",
      "unit_of_measurement": "%",
      "value_template": "{{ value_json.battery }}"
    }
  },
  {
    "topic": "homeassistant/sensor/openqiara_32_temperature/config",
    "payload": {
      "device": {
        "identifiers": [
          "openqiara_32"
        ],
        "manufacturer": "Qiara/Cofidur",
        "model": "HOMELABSRN",
        "name": "OpenQiara SRN 32"
      },
      "device_class": "temperature",
      "json_attributes_topic": "openqiara/sensor/32/state",
      "name": "OpenQiara SRN 32 Température",
      "state_topic": "openqiara/sensor/32/state",
      "unique_id": "openqiara_srn_32_temperature",
      "unit_of_measurement": "°C",
      "value_template": "{{ value_json.temperature if value_json.temperature is defined else None }}"
    }
  }
]
